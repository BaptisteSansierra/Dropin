default_platform(:ios)

# testing...
lane :check_key do
  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
  latest_testflight_build_number(
    api_key: api_key,
    app_identifier: "com.batsansierra.Dropin"
  )
end

lane :beta do
  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
  match(type: "appstore", readonly: true)
  increment_build_number(xcodeproj: "Dropin.xcodeproj")
  build_app(scheme: "Dropin")
  upload_to_testflight(api_key: api_key)
end




# Pull the current listing from appstore
# fastlane deliver download_metadata

# COMMAND: fastlane deliver download_metadata
# ⚠ it overwrites fastlane/metadata/<locale>/*.txt: the source is fastlane/AppStoreMetadata.xcstrings

# App Store Connect refuses release notes on the app's first version: remove once 0.1.0 is live
FIRST_RELEASE = true

desc "Upload metadata only (no build, no screenshots)"
lane :metadata do
  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
  # fastlane/AppStoreMetadata.xcstrings → fastlane/metadata/<locale>/*.txt (release_notes.<MARKETING_VERSION>)
  version = get_version_number(xcodeproj: "Dropin.xcodeproj", target: "Dropin")
  args = ["--version", version]
  args << "--skip-release-notes" if FIRST_RELEASE
  sh("../scripts/appstore_metadata.sh", *args)
  deliver(
    api_key: api_key,
    skip_binary_upload: true,
    skip_screenshots: true,
    force: true,               # skip the HTML preview confirmation
    submit_for_review: false,
    run_precheck_before_submit: false
  )
end


desc "Upload screenshots only (no build, no metadata)"
lane :store_screenshots do
  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
  deliver(
    api_key: api_key,
    skip_binary_upload: true,
    skip_metadata: true,
    overwrite_screenshots: true,   # replaces what's on App Store Connect
    force: true,                   # skip the HTML preview confirmation
    submit_for_review: false,
    run_precheck_before_submit: false
  )
end

