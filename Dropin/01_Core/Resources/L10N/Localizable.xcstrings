    "privacy.body.intro": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropin is an independent, one-person project, a simple tool to build your own map of places that matter to you. No ads, no algorithm, no accounts sold to anyone. Your places are yours: stored on your device, exportable anytime, in a format you can read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropin est un projet indépendant, développé par une seule personne : un outil simple pour créer votre propre carte des lieux qui comptent pour vous. Pas de publicité, pas d'algorithme, aucun compte revendu à qui que ce soit. Vos lieux vous appartiennent : stockés sur votre appareil, exportables à tout moment, dans un format que vous pouvez lire."
          }
        }
      }
    },
    "privacy.body.terms.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropin is provided as-is, for personal use. By using the app you agree not to misuse the service; we may update these terms as the app evolves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropin est fourni tel quel, pour un usage personnel. En utilisant l'application, vous acceptez de ne pas détourner le service ; nous pourrons mettre à jour ces conditions à mesure que l'application évolue."
          }
        }
      }
    },
    "privacy.body.terms.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of use."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditions d'utilisation."
          }
        }
      }
    },
    "privacy.body.what_we_collect.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places, groups, tags, and photos you add are stored on your device and in our Supabase database. This data is never shared, sold, or used for advertising."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux, groupes, tags et photos que vous ajoutez sont stockés sur votre appareil et dans notre base de données Supabase. Ces données ne sont jamais partagées, vendues, ni utilisées à des fins publicitaires."
          }
        }
      }
    },
    "privacy.body.what_we_collect.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we collect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que nous collectons."
          }
        }
      }
    },
    "privacy.body.your_rights.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may export or permanently delete all your data at any time from Settings or your Profile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez exporter ou supprimer définitivement toutes vos données à tout moment depuis les Réglages ou votre Profil."
          }
        }
      }
    },
