    "about.pitch" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin is an independent project, a simple tool to build your own map of places that matter to you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dropin es un proyecto independiente, una herramienta sencilla para crear tu propio mapa de los lugares que te importan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin est un projet indépendant, un outil simple pour créer votre propre carte des lieux qui comptent pour vous."
          }
        }
      }
    },
