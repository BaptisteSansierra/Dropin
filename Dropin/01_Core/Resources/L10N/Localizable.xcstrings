    "privacy.body.account_data.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you create an account, we store your email and display name to authenticate you and enable sync across devices, nothing more."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous créez un compte, nous stockons votre e-mail et votre nom d'affichage afin de vous authentifier et de permettre la synchronisation entre appareils, rien de plus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si creas una cuenta, guardamos tu correo electrónico y tu nombre visible para identificarte y sincronizar tus dispositivos, nada más."
          }
        }
      }
    },
    "privacy.body.account_data.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Données de compte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Datos de la cuenta."
          }
        }
      }
    },
    "privacy.body.analytics.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin uses Sentry to catch and diagnose crashes and errors, not for analytics, advertising, or tracking your activity. When you're signed in, error reports may include your account details so we can look into issues affecting you specifically. Dropin does not use any third-party analytics or advertising SDKs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin utilise Sentry pour détecter et diagnostiquer les plantages et les erreurs, pas pour l'analyse, la publicité ou le suivi de votre activité. Lorsque vous êtes connecté, les rapports d'erreur peuvent inclure les détails de votre compte afin que nous puissions examiner les problèmes qui vous concernent. Dropin n'utilise aucun SDK d'analyse ou de publicité tiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dropin usa Sentry para detectar y diagnosticar cierres inesperados y errores, no para analítica, publicidad ni para seguir tu actividad. Cuando has iniciado sesión, los informes de errores pueden incluir los datos de tu cuenta para que podamos investigar los problemas que te afectan a ti en concreto. Dropin no usa ningún SDK de analítica ni de publicidad de terceros."
          }
        }
      }
    },
    "privacy.body.analytics.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crash and error reporting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapports de plantage et d'erreurs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Informes de cierres y errores."
          }
        }
      }
    },
    "privacy.body.contact_%@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questions? Contact %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des questions ? Contactez %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "¿Tienes preguntas? Escribe a %@."
          }
        }
      }
    },
    "privacy.body.terms.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin is provided as-is, for personal use. By using the app you agree not to misuse the service; we may update these terms as the app evolves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dropin est fourni tel quel, pour un usage personnel. En utilisant l'application, vous acceptez de ne pas détourner le service ; nous pourrons mettre à jour ces conditions à mesure que l'application évolue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dropin se ofrece tal cual, para uso personal. Al usar la app, te comprometes a no hacer un uso indebido del servicio; podemos actualizar estas condiciones a medida que la app evolucione."
          }
        }
      }
    },
    "privacy.body.terms.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terms of use."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conditions d'utilisation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Condiciones de uso."
          }
        }
      }
    },
    "privacy.body.what_we_collect.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Places, categories, tags, and photos you add are stored on your device and on secure third-party cloud servers, which may be located outside your country. This data is never shared, sold, or used for advertising."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux, catégories, tags et photos que vous ajoutez sont stockés sur votre appareil et sur des serveurs cloud tiers sécurisés, pouvant être situés hors de votre pays. Ces données ne sont jamais partagées, vendues, ni utilisées à des fins publicitaires."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los lugares, categorías, etiquetas y fotos que añades se guardan en tu dispositivo y en servidores en la nube seguros de terceros, que pueden estar fuera de tu país. Estos datos nunca se comparten, se venden ni se usan con fines publicitarios."
          }
        }
      }
    },
    "privacy.body.what_we_collect.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What we collect."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que nous collectons."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Qué recopilamos."
          }
        }
      }
    },
    "privacy.body.your_rights.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You may export or permanently delete all your data at any time from Settings or your Profile."
