    "profile.logout.info_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some places, categories, or tags may have been modified recently, or while your device was offline, and haven't been synced to the server yet. To avoid losing any data, connect to the internet and wait a few seconds before logging out."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains lieux, catégories ou tags ont peut-être été modifiés récemment, ou pendant que votre appareil était hors-ligne, et n'ont pas encore été synchronisés avec le serveur. Pour éviter toute perte de données, connectez-vous à internet et attendez quelques secondes avant de vous déconnecter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es posible que algunos lugares, categorías o etiquetas se hayan modificado recientemente, o mientras tu dispositivo estaba sin conexión, y aún no se hayan sincronizado con el servidor. Para no perder datos, conéctate a internet y espera unos segundos antes de cerrar sesión."
          }
        }
      }
    },
