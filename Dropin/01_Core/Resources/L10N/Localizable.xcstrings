    "about.no_ads.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No ad trackers, no algorithm, no accounts sold to anyone."
          }
        },
        "es" : {
          "stringUnit" : {
