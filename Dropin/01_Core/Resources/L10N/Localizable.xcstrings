    "profile.logout.info_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some places, groups, or tags may have been modified recently - or while your device was offline - and haven't been synced to the server yet. To avoid losing any data, connect to the internet and wait a few seconds before logging out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains lieux, groupes ou tags ont peut-être été modifiés récemment - ou pendant que votre appareil était hors-ligne - et n'ont pas encore été synchronisés avec le serveur. Pour éviter toute perte de données, connectez-vous à internet et attendez quelques secondes avant de vous déconnecter."
          }
        }
      }
    },
    "profile.logout.info_title": {
      "extractionState": "manual",
      "localizations": {
