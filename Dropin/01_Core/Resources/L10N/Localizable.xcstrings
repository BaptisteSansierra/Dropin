        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se eliminarán definitivamente todos tus lugares, categorías y etiquetas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
