    "apple_poi_fetch.error.corrupted.body" : {
      "comment" : "Alert body shown when Apple Maps doesn't recognize the place's stored identifier",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps didn't recognize this place. This may resolve itself on a later try."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Maps n'a pas reconnu ce lieu. Cela peut se résoudre lors d'un prochain essai."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Apple Maps no ha reconocido este lugar. Es posible que se solucione en otro intento."
