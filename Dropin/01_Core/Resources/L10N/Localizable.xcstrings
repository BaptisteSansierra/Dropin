    "about.data_yours.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You own your data from end to end, exportable anytime, in a format you can read."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes propriétaire de vos données de bout en bout, exportables à tout moment, dans un format que vous pouvez lire."
          }
        }
      }
    },
