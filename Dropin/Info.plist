<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Dropin Export</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.dropin.export</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GeoJSON</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.dropin.geojson</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.batsansierra.Dropin.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>DEBUG_SIGNIN_EMAIL</key>
	<string>$(DEBUG_SIGNIN_EMAIL)</string>
	<key>DEBUG_SIGNIN_PASSWORD</key>
	<string>$(DEBUG_SIGNIN_PASSWORD)</string>
	<key>DEBUG_SIGNUP_EMAIL_PREFIX</key>
	<string>$(DEBUG_SIGNUP_EMAIL_PREFIX)</string>
	<key>DEBUG_SIGNUP_EMAIL_SUFFIX</key>
	<string>$(DEBUG_SIGNUP_EMAIL_SUFFIX)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>SENTRY_DSN</key>
	<string>$(SENTRY_DSN)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Dropin Export</string>
			<key>UTTypeIdentifier</key>
			<string>com.dropin.export</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>dropin</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.dropin+json</string>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Geojson from Mapstr or other apps</string>
			<key>UTTypeIcons</key>
			<dict/>
			<key>UTTypeIdentifier</key>
			<string>com.dropin.geojson</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>geojson</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/geo+json</string>
					<string>application/vnd.geo+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
