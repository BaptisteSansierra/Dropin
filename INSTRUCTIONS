##  simulator


# Open a password reset deep link 
xcrun simctl openurl booted "https://dropin.lat/reset-password.html?token_hash=123456&type=recovery"

# Open an email confirmation deep link (any token: shows the "expired" alert)
xcrun simctl openurl booted "https://dropin.lat/email-confirmed.html?token_hash=123456&type=signup"

# Same pages without .html (Cloudflare serves both, the app accepts both)
xcrun simctl openurl booted "https://dropin.lat/reset-password?token_hash=123456&type=recovery"

# Supabase error redirect (no token): "expired" alert without any network call
xcrun simctl openurl booted "https://dropin.lat/reset-password.html?error=access_denied&error_code=otp_expired"

# Open the app's own scheme ("Open Dropin" button on the web pages)
xcrun simctl openurl booted "dropin://signin"

# Uninstall the app: iOS reloads the apple-app-site-association file on the next install
xcrun simctl uninstall booted com.batsansierra.Dropin

# App logs from the last 15 minutes (crash reasons, assertions...)
xcrun simctl spawn booted log show --last 15m --style compact --predicate 'process == "Dropin"'

# Live app logs
xcrun simctl spawn booted log stream --style compact --predicate 'process == "Dropin"'




